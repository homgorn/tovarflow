# Q-Parser API credentials. Copy this file to .env (which is gitignored) and fill in the key.
# Get the key at https://q-parser.ru/my/profile -> API key.
QPARSER_API_KEY=replace_with_your_key

# API endpoints. The mock is a local emulator for development without a paid plan.
QPARSER_BASE_URL=https://q-parser.ru/api/v1
QPARSER_MOCK_URL=http://127.0.0.1:8765/api/v1
USE_MOCK=0

# First vertical slice
INGEST_DOMAIN=demo-home.ru
INGEST_LIMIT=1000
